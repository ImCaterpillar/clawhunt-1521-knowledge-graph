{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "知识图谱实体",
  "type": "object",
  "required": ["entity_id", "name", "type", "evidence_refs"],
  "additionalProperties": false,
  "properties": {
    "entity_id": { "type": "string", "pattern": "^ent-[a-z][a-z0-9-]{2,47}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "type": {
      "type": "string",
      "enum": ["person", "org", "system", "process", "document",
               "knowledge_entry", "domain", "project"]
    },
    "properties": { "type": "object" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "证据引用（回链到来源资料，可追溯）"
    }
  }
}